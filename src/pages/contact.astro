---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact & Community Support: ICSE Resources"
  description="Contact the ICSE Resources development team, submit feedback, suggest new study materials or prelim papers, and join our Discord and Reddit communities."
  currentPath="/contact"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Contact</span>
    </nav>

    <!-- Page Header -->
    <header class="space-y-4 border-b border-border/40 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold">
        Community & Support Hub
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
        Contact & Community Support
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        Have feedback, found a broken link, or wish to contribute your school's prelim question papers? Here is how to reach out to our team.
      </p>
    </header>

    <!-- Communication Channels Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">

      <!-- Discord -->
      <div class="rounded-2xl border border-border bg-card p-6 space-y-3 hover:border-primary/40 transition-colors">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-indigo-500/10 text-indigo-500">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.0777.0777 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-foreground">Discord (ICSEcord)</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Join active discussions with thousands of ICSE students, ask homework questions, and participate in peer study groups.
        </p>
        <div class="pt-2">
          <a
            href="https://discord.gg/xGD8SnvuKX"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1"
          >
            Join Discord Server &rarr;
          </a>
        </div>
      </div>

      <!-- Reddit -->
      <div class="rounded-2xl border border-border bg-card p-6 space-y-3 hover:border-primary/40 transition-colors">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-orange-500/10 text-orange-500">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-foreground">Reddit (r/ICSE)</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Participate in the largest online ICSE community. Discuss syllabus changes, exam strategies, and share resources with fellow candidates.
        </p>
        <div class="pt-2">
          <a
            href="https://reddit.com/r/ICSE"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1"
          >
            Visit r/ICSE Subreddit &rarr;
          </a>
        </div>
      </div>

      <!-- GitHub -->
      <div class="rounded-2xl border border-border bg-card p-6 space-y-3 hover:border-primary/40 transition-colors">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-gray-500/10 text-foreground">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-foreground">GitHub Repository</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Track issues, report bugs, view open-source website code, and submit feature requests or pull requests.
        </p>
        <div class="pt-2">
          <a
            href="https://github.com/Jivaansh-Yadav/class-10-icse"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1"
          >
            GitHub Issues &rarr;
          </a>
        </div>
      </div>

      <!-- Developer Email & Contact -->
      <div class="rounded-2xl border border-border bg-card p-6 space-y-3 hover:border-primary/40 transition-colors">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-foreground">Email & Direct Inquiries</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          For institutional inquiries, resource contributions, or copyright notices, reach out directly to the curator.
        </p>
        <div class="pt-2">
          <span class="text-sm font-mono text-foreground font-semibold">
            jivaansh.yadav@gmail.com
          </span>
        </div>
      </div>

    </section>

    <!-- Contribution & Feedback Guidelines -->
    <section class="rounded-2xl border border-border bg-card/60 p-6 sm:p-10 space-y-6">
      <h2 class="text-2xl font-bold text-foreground">Guidelines for Feedback & Resource Contributions</h2>
      <div class="space-y-4 text-sm text-muted-foreground leading-relaxed">
        <p>
          We warmly invite students, teachers, and school alumni to contribute high-quality academic resources to help future batches:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong class="text-foreground">School Prelim Papers:</strong> Please ensure question papers are cleanly scanned in PDF format with clear school name and year. Solved answer keys or marking schemes are especially appreciated!
          </li>
          <li>
            <strong class="text-foreground">Handwritten Revision Notes:</strong> To maintain readability, ensure notes are organized chapter-wise with clear headings, formulas, and diagram labels.
          </li>
          <li>
            <strong class="text-foreground">Reporting Dead Links or Corrections:</strong> If a Google Drive link shows access issues or contains typographical errata in textbook answers, please open an issue on GitHub or ping us on Discord.
          </li>
        </ul>
      </div>
    </section>

    <!-- Navigation Links -->
    <div class="pt-6 border-t border-border/40 flex flex-wrap gap-4">
      <a href="/" class="text-sm font-semibold text-primary hover:underline">
        &larr; Return to Home
      </a>
      <a href="/study-materials" class="text-sm font-semibold text-primary hover:underline">
        Browse Study Materials &rarr;
      </a>
      <a href="/about" class="text-sm font-semibold text-primary hover:underline">
        About Project &rarr;
      </a>
    </div>

  </div>
</BaseLayout>
