---
interface Props {
  selectedClass?: number | string;
}

const { selectedClass } = Astro.props;
const classes = [12, 11, 10, 9];
---

<nav class="class-navigation" aria-label="Choose your class">
  <div class="class-navigation-heading">
    <p>Choose your class</p>
    <span>Class 10 resources are ready to explore</span>
  </div>
  <div class="class-navigation-grid">
    {classes.map((grade) => (
      <a
        href={`/study-materials?class=${grade}`}
        class:list={["class-link", { "class-link-available": grade === 10 }]}
        data-class-link={grade}
        aria-current={String(selectedClass) === String(grade) ? "page" : undefined}
      >
        <span class="class-link-title">Class {grade}</span>
        <span class="class-link-status">
          {grade === 10 && <span class="class-status-dot" aria-hidden="true"></span>}
          {grade === 10 ? "Available" : "Coming soon"}
        </span>
        <svg class="class-link-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    ))}
  </div>
</nav>

<style>
  .class-navigation { width: 100%; }
  .class-navigation-heading { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; margin-bottom: .65rem; }
  .class-navigation-heading p { font-size: .875rem; font-weight: 650; color: hsl(var(--foreground)); }
  .class-navigation-heading > span { font-size: .75rem; color: hsl(var(--muted-foreground)); }
  .class-navigation-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; }
  .class-link { position: relative; display: flex; flex-direction: column; gap: .3rem; padding: .9rem 1rem; border: 1px solid hsl(var(--border)); border-radius: .85rem; background: hsl(var(--card) / .9); transition: background-color 160ms ease, border-color 160ms ease; }
  .class-link:hover { background: hsl(var(--accent)); border-color: hsl(var(--foreground) / .35); }
  .class-link:focus-visible { outline: 3px solid hsl(var(--ring)); outline-offset: 4px; }
  .class-link-available { border-color: hsl(var(--primary) / .4); background: hsl(var(--primary) / .06); }
  .class-link[aria-current="page"] { border-color: hsl(var(--primary)); box-shadow: inset 0 0 0 1px hsl(var(--primary)); background: hsl(var(--primary) / .09); }
  .class-link-title { font-size: 1rem; font-weight: 700; color: hsl(var(--foreground)); }
  .class-link-status { display: flex; align-items: center; gap: .35rem; font-size: .7rem; line-height: 1.3; color: hsl(var(--muted-foreground)); }
  .class-link-available .class-link-status { color: hsl(var(--foreground)); }
  .class-status-dot { width: .375rem; height: .375rem; border-radius: 50%; background: hsl(var(--foreground)); }
  .class-link-arrow { position: absolute; right: 1rem; top: 50%; width: 1rem; height: 1rem; transform: translateY(-50%); color: hsl(var(--muted-foreground)); }
  @media (max-width: 639px) {
    .class-navigation-heading { display: block; }
    .class-navigation-heading > span { display: block; margin-top: .2rem; }
    .class-navigation-grid { gap: .4rem; }
    .class-link { padding: .75rem .4rem; align-items: center; text-align: center; border-radius: .7rem; }
    .class-link-title { font-size: .875rem; }
    .class-link-status { font-size: .625rem; gap: .2rem; }
    .class-link-arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .class-link { transition: none; } }
</style>
