---
import ThemeToggle from "./islands/ThemeToggle";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Logo & Site Title -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 font-bold text-lg text-foreground hover:opacity-90 transition-opacity">
        <div class="p-2 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <span class="tracking-tight">ICSE <span class="text-primary font-extrabold">Resources</span></span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
        <a
          href="/study-materials"
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            currentPath.startsWith("/study-materials")
              ? "bg-accent text-foreground font-semibold"
              : "text-muted-foreground hover:text-foreground hover:bg-accent/50"
          }`}
        >
          Study Materials
        </a>
        <a
          href="/cisce"
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            currentPath.startsWith("/cisce")
              ? "bg-accent text-foreground font-semibold"
              : "text-muted-foreground hover:text-foreground hover:bg-accent/50"
          }`}
        >
          CISCE
