---
// ArchiveNotice.astro
//
// One-time, dismissible notice telling visitors this catalogue is frozen and
// pointing them at Lambda Prep (https://lambda-prep.pages.dev).
//
// Design notes: warm paper card on the site's cream/terracotta system, an
// editorial "notice slip" rather than a blocking modal so the page underneath
// stays usable. All colours come from the existing CSS variables, so the
// dark theme follows automatically. No framework island — plain markup plus a
// small inline script.
---

<aside
  id="archive-notice"
  class="archive-notice"
  role="region"
  aria-label="This site is no longer maintained"
  hidden
>
  <span class="archive-notice__rule" aria-hidden="true"></span>
  <span class="archive-notice__glow" aria-hidden="true"></span>

  <button type="button" class="archive-notice__close" data-archive-close aria-label="Dismiss notice">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <p class="archive-notice__eyebrow">
    <span class="archive-notice__pip" aria-hidden="true"></span>
    Archive notice
  </p>

  <h2 class="archive-notice__title">This library is no longer maintained.</h2>

  <p class="archive-notice__body">
    New papers stopped landing here and old links have quietly rotted. The live successor is
    <strong>Lambda Prep</strong> — interactive class hubs, lectures that play in place, and one sorted
    catalogue for ICSE&nbsp;9, ICSE&nbsp;10, ISC&nbsp;11 and ISC&nbsp;12.
  </p>

  <ul class="archive-notice__points">
    <li><span aria-hidden="true">&rarr;</span> Four classes, CISCE and community sets in one place</li>
    <li><span aria-hidden="true">&rarr;</span> Video lessons and revision notes, playable inline</li>
    <li><span aria-hidden="true">&rarr;</span> Refreshed every Monday, so nothing goes stale</li>
  </ul>

  <div class="archive-notice__actions">
    <a
      class="archive-notice__cta"
      href="https://lambda-prep.pages.dev/?utm_source=icse-resources&utm_medium=archive-notice"
      target="_blank"
      rel="noopener"
    >
      Open Lambda Prep
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
    <button type="button" class="archive-notice__ghost" data-archive-close>Keep browsing</button>
  </div>

  <button type="button" class="archive-notice__never" data-archive-never>Don&rsquo;t show this again</button>
</aside>

<style>
  .archive-notice {
    position: fixed;
    z-index: 60;
    right: 1.25rem;
    bottom: 1.25rem;
    width: min(23.5rem, calc(100vw - 2.5rem));
    padding: 1.35rem 1.4rem 1.15rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    background: hsl(var(--card));
    color: hsl(var(--card-foreground));
    box-shadow:
      0 1px 0 hsl(var(--card)) inset,
      0 18px 40px -20px hsl(var(--foreground) / 0.35),
      0 2px 8px -4px hsl(var(--foreground) / 0.2);
    animation: archive-notice-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .archive-notice[hidden] {
    display: none;
  }

  /* A quiet terracotta wash in the corner, echoing the breathing orbs. */
  .archive-notice__glow {
    position: absolute;
    top: -4.5rem;
    right: -4rem;
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    background: radial-gradient(circle, hsl(var(--primary) / 0.22), transparent 68%);
    pointer-events: none;
  }

  /* Thin rule that runs the height of the card, like a printed margin. */
  .archive-notice__rule {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, hsl(var(--primary)), hsl(var(--primary) / 0.15));
  }

  .archive-notice__close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .archive-notice__close svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .archive-notice__close:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--accent));
  }

  .archive-notice__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.55rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }

  .archive-notice__pip {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px hsl(var(--primary) / 0.16);
  }

  .archive-notice__title {
    margin: 0 0 0.6rem;
    padding-right: 1.5rem;
    font-size: 1.075rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: hsl(var(--foreground));
  }

  .archive-notice__body {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }

  .archive-notice__body strong {
    font-weight: 650;
    color: hsl(var(--accent-foreground));
  }

  .archive-notice__points {
    margin: 0.85rem 0 0;
    padding: 0.7rem 0 0;
    list-style: none;
    border-top: 1px dashed hsl(var(--border));
    display: grid;
    gap: 0.35rem;
    font-size: 0.775rem;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .archive-notice__points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .archive-notice__points span {
    flex: none;
    margin-top: 0.05rem;
    color: hsl(var(--primary));
    font-size: 0.8rem;
  }

  .archive-notice__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .archive-notice__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    padding: 0.6rem 0.9rem;
    border-radius: 0.55rem;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .archive-notice__cta svg {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.18s ease;
  }

  .archive-notice__cta:hover {
    filter: brightness(1.06);
  }

  .archive-notice__cta:hover svg {
    transform: translateX(2px);
  }

  .archive-notice__cta:active {
    transform: scale(0.985);
  }

  .archive-notice__ghost {
    flex: none;
    padding: 0.6rem 0.7rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .archive-notice__ghost:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--accent));
  }

  .archive-notice__never {
    display: block;
    margin: 0.7rem 0 0;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.7rem;
    color: hsl(var(--muted-foreground) / 0.85);
    text-decoration: underline;
    text-decoration-color: hsl(var(--border));
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .archive-notice__never:hover {
    color: hsl(var(--foreground));
  }

  .archive-notice__close:focus-visible,
  .archive-notice__ghost:focus-visible,
  .archive-notice__never:focus-visible,
  .archive-notice__cta:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }

  @keyframes archive-notice-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 640px) {
    .archive-notice {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 0.75rem;
      width: auto;
      padding: 1.2rem 1.15rem 1rem;
    }

    .archive-notice__title {
      font-size: 1.02rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-notice {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const node = document.getElementById('archive-notice');
    if (!node) return;

    const VISIT_KEY = 'icse_archive_notice_seen';
    const NEVER_KEY = 'icse_archive_notice_hidden';

    try {
      if (localStorage.getItem(NEVER_KEY) === '1') return;
      if (sessionStorage.getItem(VISIT_KEY) === '1') return;
    } catch (_) {
      /* storage blocked — show the notice anyway */
    }

    const hide = (permanent) => {
      node.hidden = true;
      try {
        sessionStorage.setItem(VISIT_KEY, '1');
        if (permanent) localStorage.setItem(NEVER_KEY, '1');
      } catch (_) {}
    };

    node.querySelectorAll('[data-archive-close]').forEach((el) => {
      el.addEventListener('click', () => hide(false));
    });

    const never = node.querySelector('[data-archive-never]');
    if (never) never.addEventListener('click', () => hide(true));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !node.hidden) hide(false);
    });

    // Let the page paint first so the card slides in over real content.
    requestAnimationFrame(() => {
      node.hidden = false;
    });
  })();
</script>
